Notebook[{Cell["LaTeX cells", "Title"], Cell["Choose LaTeX from the cell style menu. Write ordinary LaTeX text, using $...$ for inline math and \\[...\\] or equation environments for display math, then press Shift+Enter. Source and rendered output are saved in this notebook. Rendering requires MaTeX, TeX and Ghostscript; viewing saved graphics does not.", "Text"], Cell["\\textbf{Maxwell's equations}\n\nHere $\\rho$ is the charge density.\n\\[\n\\begin{aligned}\n  \\nabla \\cdot \\mathbf{E} &= \\frac{\\rho}{\\varepsilon_0} \\\\\n  \\nabla \\cdot \\mathbf{B} &= 0\n\\end{aligned}\n\\]\n\nA new paragraph starts after a blank line.", "LaTeX"]}, StyleDefinitions -> Notebook[{Cell[StyleData[StyleDefinitions -> "Default.nb"]], Cell[StyleData["LaTeX", StyleDefinitions -> StyleData["Input"]], MenuSortingValue -> 1500, Evaluatable -> True, CellGroupingRules -> "InputGrouping", FormatType -> InputForm, DefaultFormatType -> InputForm, FontFamily -> Dynamic[AbsoluteCurrentValue[{StyleHints, "CodeFont"}]], ShowAutoStyles -> False, AutoQuoteCharacters -> {}, CodeAssistOptions -> {"AutoPopupEnable" -> False}, CellEvaluationFunction -> ((If[ !StringQ[#1], Print["This cell contains two-dimensional notation. Replace its contents with raw LaTeX, such as $\\frac{1}{2}$."]; $Failed, If[Quiet[Check[Needs["MaTeX`"], $Failed]] === $Failed, Print["Install MaTeX, TeX and Ghostscript to render this cell. Saved output remains viewable."]; $Failed, MaTeX[StringJoin["\\hbox{\\parbox{15cm}{\n", StringReplace[#1, "" -> "\n"], "\n}}"], FontSize -> 16]]] & )[(If[VectorQ[#1, StringQ], StringJoin[#1], $Failed] & )[Flatten[{If[TrueQ[$Notebooks], (If[MatchQ[#1, _Cell], First[#1], $Failed] & )[Quiet[Check[NotebookRead[EvaluationCell[]], $Failed]]], #1] /. {BoxData -> List, RowBox -> List, TextData -> List}}]]] & )]}, Visible -> False]]